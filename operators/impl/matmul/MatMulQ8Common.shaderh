struct PushConstants {
    uint M;           // rows of A / rows of output
    uint K;           // cols of A / rows of B (inner dimension)
    uint N;           // cols of B / cols of output
    uint strideA;     // padded K for A (multiple of 4)
    uint strideBN;    // padded N for B [K, N] (in int8 bytes, multiple of 4)
    uint strideC;     // padded N for output C (multiple of 4)
    uint scaleStride; // padded N for scales [K/32, N] (multiple of 4)
};
[[vk::push_constant]] PushConstants pc;

// A: activations [M, K] — standard float/half access via vec4
[[vk::binding(0, 0)]] StructuredBuffer<%VEC_DTYPE_INPUT1%> dataA;

// B: packed int8 weights [K, N] stored as uint (4 int8 values per uint32)
// Transposed at load time to match matmul layout convention.
[[vk::binding(1, 0)]] StructuredBuffer<uint> packedB;

// B scales: [K/32, N], one scale per 32-element block
[[vk::binding(2, 0)]] StructuredBuffer<%VEC_DTYPE_SCALES%> scalesB;

// D: fusion input [M, N] — dummy buffer when no fusion active
[[vk::binding(3, 0)]] StructuredBuffer<%VEC_DTYPE_OUTPUT%> dataD;

// C: output [M, N]
[[vk::binding(4, 0)]] RWStructuredBuffer<%SCALAR_DTYPE_OUTPUT%> dataC;

// Fusion type: 0 = none, 1 = SiLU, 2 = binary op
[[vk::constant_id(1)]] const uint FUSION_TYPE = 0;
// Binary op selector (only used when FUSION_TYPE == 2)
[[vk::constant_id(2)]] const uint BINARY_OP = 0;

// Write a single output element, applying fusion post-processing if enabled.
// Fusion logic is inlined via specialization constants — the GPU driver
// dead-code-eliminates unused branches at pipeline creation time.
void writeOutput(uint row, uint col, %SCALAR_DTYPE_OUTPUT% value) {
    uint idx = row * pc.strideC + col;
    if (FUSION_TYPE == 1) {
        // SiLU: x * sigmoid(x)
        float x = float(value);
        value = (%SCALAR_DTYPE_OUTPUT%)(x / (1.0 + exp(-x)));
    } else if (FUSION_TYPE == 2) {
        // Binary op with fusion input D
        float a = float(value);
        float b = float(dataD[idx >> 2][idx & 3]);
        float r = a;
        switch (BINARY_OP) {
            case OP_BINARY_ADD:       r = a + b; break;
            case OP_BINARY_SUB:       r = a - b; break;
            case OP_BINARY_MUL:       r = a * b; break;
            case OP_BINARY_DIV:       r = a / b; break;
            case OP_BINARY_MOD:       r = a - b * floor(a / b); break;
            case OP_BINARY_POW:       r = pow(a, b); break;
            case OP_BINARY_FLOOR_DIV: r = floor(a / b); break;
            case OP_BINARY_MIN:       r = min(a, b); break;
            case OP_BINARY_MAX:       r = max(a, b); break;
            default:                  r = a + b; break;
        }
        value = (%SCALAR_DTYPE_OUTPUT%)r;
    }
    dataC[idx] = value;
}

%SCALAR_DTYPE_INPUT1% loadA(uint row, uint col) {
    if (row >= pc.M || col >= pc.K) return (%SCALAR_DTYPE_INPUT1%)(0);
    uint idx = row * pc.strideA + col;
    return dataA[idx >> 2][idx & 3];
}

// Unchecked variant — skip bounds checks for interior workgroups
%SCALAR_DTYPE_INPUT1% loadA_fast(uint row, uint col) {
    uint idx = row * pc.strideA + col;
    return dataA[idx >> 2][idx & 3];
}

// Unchecked B load — skip bounds check (caller guarantees in-bounds)
float loadB_fast(uint k, uint n) {
    uint byteIdx = k * pc.strideBN + n;
    uint packed = packedB[byteIdx >> 2];
    uint shift = (byteIdx & 3u) * 8u;
    uint rawByte = (packed >> shift) & 0xFFu;
    int val = (int)((int)(rawByte << 24) >> 24);

    uint scaleIdx = (k >> 5) * pc.scaleStride + n;
#ifdef DTYPE_SCALES_IS_INT8
    int packedScale = scalesB[scaleIdx >> 4][(scaleIdx >> 2) & 3];
    uint scaleShift = (scaleIdx & 3u) * 8u;
    uint scaleByte = (uint(packedScale) >> scaleShift) & 0xFFu;
    float scale = float((int)((int)(scaleByte << 24) >> 24));
#else
    float scale = float(scalesB[scaleIdx >> 2][scaleIdx & 3]);
#endif

    return float(val) * scale;
}

// Sequential access with inline Q8_0 dequantization.
// B[k][n] = int8_values[k][n] * scale[k/32][n]
float loadB(uint k, uint n) {
    if (k >= pc.K || n >= pc.N) return 0.0f;

    // Read int8 value from B[k][n]
    uint byteIdx = k * pc.strideBN + n;
    uint packed = packedB[byteIdx >> 2];
    uint shift = (byteIdx & 3u) * 8u;
    uint rawByte = (packed >> shift) & 0xFFu;
    // Sign-extend from 8-bit to 32-bit
    int val = (int)((int)(rawByte << 24) >> 24);

    // Read per-block scale from scalesB[k/32][n]
    uint scaleIdx = (k >> 5) * pc.scaleStride + n;
#ifdef DTYPE_SCALES_IS_INT8
    int packedScale = scalesB[scaleIdx >> 4][(scaleIdx >> 2) & 3];
    uint scaleShift = (scaleIdx & 3u) * 8u;
    uint scaleByte = (uint(packedScale) >> scaleShift) & 0xFFu;
    float scale = float((int)((int)(scaleByte << 24) >> 24));
#else
    float scale = float(scalesB[scaleIdx >> 2][scaleIdx & 3]);
#endif

    return float(val) * scale;
}
