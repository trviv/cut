struct PushConstants {
    uint M;  // rows of A
    uint K;  // cols of A / rows of B
    uint N;  // cols of B
    uint strideA; // padded K (multiple of 4)
    uint strideB; // padded N for B (multiple of 4)
    uint strideC; // padded N for output C (multiple of 4, same value as strideB)
};
[[vk::push_constant]] PushConstants pc;

[[vk::binding(0, 0)]] StructuredBuffer<%VEC_DTYPE_INPUT1%> dataA;
[[vk::binding(1, 0)]] StructuredBuffer<%VEC_DTYPE_INPUT2%> dataB;

// D: fusion input [M, N] — dummy buffer when no fusion active
[[vk::binding(2, 0)]] StructuredBuffer<%VEC_DTYPE_OUTPUT%> dataD;

// C: output [M, N]
[[vk::binding(3, 0)]] RWStructuredBuffer<%SCALAR_DTYPE_OUTPUT%> dataC;

// Fusion type: 0 = none, 1 = unary, 2 = binary op
[[vk::constant_id(1)]] const uint FUSION_TYPE = 0;
// Fusion op selector: unary op code when FUSION_TYPE == 1, binary op code when FUSION_TYPE == 2
[[vk::constant_id(2)]] const uint FUSION_OP = 0;

// Write a single output element, applying fusion post-processing if enabled.
// Fusion logic is inlined via specialization constants — the GPU driver
// dead-code-eliminates unused branches at pipeline creation time.
void writeOutput(uint row, uint col, %SCALAR_DTYPE_OUTPUT% value) {
    uint idx = row * pc.strideC + col;
    if (FUSION_TYPE == 1) {
        float x = float(value);
        switch (FUSION_OP) {
            case OP_UNARY_NEG:        x = -x; break;
            case OP_UNARY_ABS:        x = abs(x); break;
            case OP_UNARY_SQRT:       x = sqrt(x); break;
            case OP_UNARY_SQUARE:     x = x * x; break;
            case OP_UNARY_RECIPROCAL: x = 1.0 / x; break;
            case OP_UNARY_EXP:        x = exp(x); break;
            case OP_UNARY_LOG:        x = log(x); break;
            case OP_UNARY_TANH:       x = tanh(x); break;
            case OP_UNARY_FLOOR:      x = floor(x); break;
            case OP_UNARY_CEIL:       x = ceil(x); break;
            case OP_UNARY_ROUND:      x = round(x); break;
            case OP_UNARY_RELU:       x = max(0.0, x); break;
            case OP_UNARY_SIGMOID:    x = 1.0 / (1.0 + exp(-x)); break;
            case OP_UNARY_GELU:       x = x * 0.5 * (1.0 + tanh(sqrt(2.0 / 3.14159265) * (x + 0.044715 * x * x * x))); break;
            case OP_UNARY_SILU:       x = x / (1.0 + exp(-x)); break;
            case OP_UNARY_SOFTPLUS:   x = log(1.0 + exp(x)); break;
            case OP_UNARY_RELU6:      x = clamp(x, 0.0, 6.0); break;
            case OP_UNARY_MISH:       x = x * tanh(log(1.0 + exp(x))); break;
            case OP_UNARY_HARDSWISH:  x = x * clamp(x / 6.0 + 0.5, 0.0, 1.0); break;
            case OP_UNARY_HARDSIGMOID: x = clamp(x / 6.0 + 0.5, 0.0, 1.0); break;
            case OP_UNARY_RSQRT:      x = rsqrt(x); break;
            default: break;
        }
        value = (%SCALAR_DTYPE_OUTPUT%)x;
    } else if (FUSION_TYPE == 2) {
        float a = float(value);
        float b = float(dataD[idx >> 2][idx & 3]);
        float r = a;
        switch (FUSION_OP) {
            case OP_BINARY_ADD:       r = a + b; break;
            case OP_BINARY_SUB:       r = a - b; break;
            case OP_BINARY_MUL:       r = a * b; break;
            case OP_BINARY_DIV:       r = a / b; break;
            case OP_BINARY_MOD:       r = a - b * floor(a / b); break;
            case OP_BINARY_POW:       r = pow(a, b); break;
            case OP_BINARY_FLOOR_DIV: r = floor(a / b); break;
            case OP_BINARY_MIN:       r = min(a, b); break;
            case OP_BINARY_MAX:       r = max(a, b); break;
            default:                  r = a + b; break;
        }
        value = (%SCALAR_DTYPE_OUTPUT%)r;
    }
    dataC[idx] = value;
}

%SCALAR_DTYPE_INPUT1% loadA(uint row, uint col) {
    if (row >= pc.M || col >= pc.K) return (%SCALAR_DTYPE_INPUT1%)(0);
    uint idx = row * pc.strideA + col;
    return dataA[idx >> 2][idx & 3];
}

%SCALAR_DTYPE_INPUT2% loadB(uint row, uint col) {
    if (row >= pc.K || col >= pc.N) return (%SCALAR_DTYPE_INPUT2%)(0);
    uint idx = row * pc.strideB + col;
    return dataB[idx >> 2][idx & 3];
}

// Remap workgroup IDs for better L2 cache locality on the B (weight) matrix.
// Converts the default row-major tile launch order to column-major so that
// consecutive workgroups (in GPU launch order) share the same B-matrix columns
// in L2 cache. For M=1 (GEMV) or single-tile grids this is a no-op.
// Only available when TILE_SIZE, TM, TN are defined (tiled variants).
#if defined(TILE_SIZE) && defined(TM) && defined(TN)
uint2 swizzleTileId(uint3 Gid) {
    uint tilesN = (pc.N + TILE_SIZE * TN - 1) / (TILE_SIZE * TN);
    uint tilesM = (pc.M + TILE_SIZE * TM - 1) / (TILE_SIZE * TM);
    if (tilesM <= 1) return uint2(Gid.x, Gid.y);
    uint linearId = Gid.y * tilesN + Gid.x;
    return uint2(linearId / tilesM, linearId % tilesM);
}
#endif

// Unchecked variants — skip bounds checks for interior workgroups
%SCALAR_DTYPE_INPUT1% loadA_fast(uint row, uint col) {
    uint idx = row * pc.strideA + col;
    return dataA[idx >> 2][idx & 3];
}

%SCALAR_DTYPE_INPUT2% loadB_fast(uint row, uint col) {
    uint idx = row * pc.strideB + col;
    return dataB[idx >> 2][idx & 3];
}
