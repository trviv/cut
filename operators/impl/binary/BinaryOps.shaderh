%VEC_DTYPE_OUTPUT% binaryOp(%VEC_DTYPE_OUTPUT% a, %VEC_DTYPE_OUTPUT% b) {
    switch (op_enum) {
        case OP_BINARY_ADD:
            return a + b;
        case OP_BINARY_SUB:
            return a - b;
        case OP_BINARY_MUL:
            return a * b;
        case OP_BINARY_DIV:
            return a / b;
        case OP_BINARY_MOD:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return (a - b * floor(a / b));
#else
            return a % b;
#endif
        case OP_BINARY_POW:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return pow(a, b);
#else
            return (%VEC_DTYPE_OUTPUT%)(0);
#endif
        case OP_BINARY_FLOOR_DIV:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return floor(a / b);
#else
            return a / b;
#endif
        case OP_BINARY_EQUAL:
            return (%VEC_DTYPE_OUTPUT%)(a == b);
        case OP_BINARY_NOT_EQUAL:
            return (%VEC_DTYPE_OUTPUT%)(a != b);
        case OP_BINARY_LESS:
            return (%VEC_DTYPE_OUTPUT%)(a < b);
        case OP_BINARY_LESS_EQUAL:
            return (%VEC_DTYPE_OUTPUT%)(a <= b);
        case OP_BINARY_GREATER:
            return (%VEC_DTYPE_OUTPUT%)(a > b);
        case OP_BINARY_GREATER_EQUAL:
            return (%VEC_DTYPE_OUTPUT%)(a >= b);
        case OP_BINARY_MIN:
            return min(a, b);
        case OP_BINARY_MAX:
            return max(a, b);
        case OP_BINARY_BITWISE_AND:
#if defined(DTYPE_OUTPUT_IS_FLOAT) && !defined(DTYPE_OUTPUT_IS_HALF)
            return asfloat(asint(a) & asint(b));
#elif !defined(DTYPE_OUTPUT_IS_FLOAT)
            return a & b;
#else
            return asfloat16(asint16(a) & asint16(b));
#endif
        case OP_BINARY_BITWISE_OR:
#if defined(DTYPE_OUTPUT_IS_FLOAT) && !defined(DTYPE_OUTPUT_IS_HALF)
            return asfloat(asint(a) | asint(b));
#elif !defined(DTYPE_OUTPUT_IS_FLOAT)
            return a | b;
#else
            return asfloat16(asint16(a) | asint16(b));
#endif
        case OP_BINARY_BITWISE_XOR:
#if defined(DTYPE_OUTPUT_IS_FLOAT) && !defined(DTYPE_OUTPUT_IS_HALF)
            return asfloat(asint(a) ^ asint(b));
#elif !defined(DTYPE_OUTPUT_IS_FLOAT)
            return a ^ b;
#else
            return asfloat16(asint16(a) ^ asint16(b));
#endif
        case OP_BINARY_LEFT_SHIFT:
#if defined(DTYPE_OUTPUT_IS_FLOAT) && !defined(DTYPE_OUTPUT_IS_HALF)
            return asfloat(asint(a) << asint(b));
#elif !defined(DTYPE_OUTPUT_IS_FLOAT)
            return a << b;
#else
            return asfloat16(asint16(a) << asint16(b));
#endif
        case OP_BINARY_RIGHT_SHIFT:
#if defined(DTYPE_OUTPUT_IS_FLOAT) && !defined(DTYPE_OUTPUT_IS_HALF)
            return asfloat(asint(a) >> asint(b));
#elif !defined(DTYPE_OUTPUT_IS_FLOAT)
            return a >> b;
#else
            return asfloat16(asint16(a) >> asint16(b));
#endif
        case OP_BINARY_LOGICAL_AND:
            return (%VEC_DTYPE_OUTPUT%)(a != (%VEC_DTYPE_OUTPUT%)(0)) * (%VEC_DTYPE_OUTPUT%)(b != (%VEC_DTYPE_OUTPUT%)(0));
        case OP_BINARY_LOGICAL_OR:
            return min((%VEC_DTYPE_OUTPUT%)(a != (%VEC_DTYPE_OUTPUT%)(0)) + (%VEC_DTYPE_OUTPUT%)(b != (%VEC_DTYPE_OUTPUT%)(0)), (%VEC_DTYPE_OUTPUT%)(1));
        case OP_BINARY_LOGICAL_XOR:
            return (%VEC_DTYPE_OUTPUT%)((a != (%VEC_DTYPE_OUTPUT%)(0)) != (b != (%VEC_DTYPE_OUTPUT%)(0)));
        case OP_BINARY_ATAN2:
#if defined(DTYPE_OUTPUT_IS_FLOAT) && !defined(DTYPE_OUTPUT_IS_HALF)
            return atan2(a, b);
#elif defined(DTYPE_OUTPUT_IS_HALF)
            return (%VEC_DTYPE_OUTPUT%)(atan2((float4)(a), (float4)(b)));
#else
            return (%VEC_DTYPE_OUTPUT%)(0);
#endif
        case OP_BINARY_HYPOT:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return sqrt(a * a + b * b);
#else
            return (%VEC_DTYPE_OUTPUT%)(0);
#endif
        case OP_BINARY_COPYSIGN:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return (%VEC_DTYPE_OUTPUT%)(sign(b)) * abs(a);
#else
            return (%VEC_DTYPE_OUTPUT%)(0);
#endif
        case OP_BINARY_FMOD:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return (a - b * floor(a / b));
#else
            return a % b;
#endif
        case OP_BINARY_LEAKY_RELU:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return lerp(b * a, a, (%VEC_DTYPE_OUTPUT%)(a > (%VEC_DTYPE_OUTPUT%)(0.0)));
#else
            return (%VEC_DTYPE_OUTPUT%)(0);
#endif
        case OP_BINARY_PRELU:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return lerp(b * a, a, (%VEC_DTYPE_OUTPUT%)(a >= (%VEC_DTYPE_OUTPUT%)(0.0)));
#else
            return (%VEC_DTYPE_OUTPUT%)(0);
#endif
        case OP_BINARY_HARDSHRINK:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return lerp((%VEC_DTYPE_OUTPUT%)(0.0), a, (%VEC_DTYPE_OUTPUT%)(abs(a) > b));
#else
            return (%VEC_DTYPE_OUTPUT%)(0);
#endif
        case OP_BINARY_SOFTSHRINK:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return (%VEC_DTYPE_OUTPUT%)(sign(a)) * max(abs(a) - b, (%VEC_DTYPE_OUTPUT%)(0.0));
#else
            return (%VEC_DTYPE_OUTPUT%)(0);
#endif
        case OP_BINARY_LOGADDEXP:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return max(a, b) + log(1.0 + exp(-abs(a - b)));
#else
            return (%VEC_DTYPE_OUTPUT%)(0);
#endif
        case OP_BINARY_LOGADDEXP2:
#ifdef DTYPE_OUTPUT_IS_FLOAT
            return max(a, b) + log2(1.0 + exp2(-abs(a - b)));
#else
            return (%VEC_DTYPE_OUTPUT%)(0);
#endif
        default:
            return (%VEC_DTYPE_OUTPUT%)(0);
    }
}
